msgid "configured SQM bandwidth not found"
msgstr "未找到已配置的 SQM 頻寬"

msgid "The aggregator is not running — start it with /etc/init.d/ctstat start"
msgstr "聚合服務未執行 — 請執行 /etc/init.d/ctstat start 啟動"

msgid "The aggregator data file is empty — it is still starting up"
msgstr "聚合資料檔案為空 — 服務仍在啟動中"

msgid "Aggregator data is unreadable — restart it with /etc/init.d/ctstat restart"
msgstr "聚合資料無法讀取 — 請執行 /etc/init.d/ctstat restart 重啟"

msgid "Aggregator data is stale — restart it with /etc/init.d/ctstat restart"
msgstr "聚合資料已過期 — 請執行 /etc/init.d/ctstat restart 重啟"

msgid "Persistence is off: the history is kept in RAM only and is lost on reboot. Set a storage path under Services - Traffic Monitor - Settings."
msgstr "持久化未啟用：歷史只儲存在記憶體中，重啟後丟失。請在「服務 → 流量監控 → 設定」中設定儲存路徑。"

msgid "Download source"
msgstr "下載來源"

msgid "Automatic (official host, then mirrors)"
msgstr "自動（先試官方位址，再試鏡像）"

msgid "Custom URL"
msgstr "自訂 URL"

msgid "Custom download URL"
msgstr "自訂下載位址"

msgid "GitHub releases are not reachable from every network: the transfer can stall with zero bytes received. “Automatic” tries the official host first and then public mirrors; pick one mirror to stay on it, or enter your own URL."
msgstr "GitHub release 在部分網路下無法訪問：傳輸可能連上後一直停在零位元組。選擇“自動”會先試官方位址，再依次嘗試公共鏡像；也可以固定使用某個鏡像，或填入自己的位址。"

msgid "Directory that holds dlc.dat_plain.yml and dlc.dat_plain.yml.sha256sum. A trailing slash is optional. Plain HTTP is allowed for a local mirror."
msgstr "存放 dlc.dat_plain.yml 與 dlc.dat_plain.yml.sha256sum 的目錄位址。結尾斜槓可省略；本地鏡像允許使用明文 HTTP。"

msgid "Download failed: %s (%s)"
msgstr "下載失敗：%s（%s）"

msgid "DNS lookup or connection failed"
msgstr "網域解析或網路連線失敗"

msgid "connection timed out"
msgstr "連線逾時"

msgid "TLS handshake or certificate failed"
msgstr "TLS 握手或憑證驗證失敗"

msgid "file not found (404)"
msgstr "檔案不存在（404）"

msgid "connection refused"
msgstr "連線被拒絕"

msgid "download error"
msgstr "下載出錯"

msgid "no response"
msgstr "無回應"

msgid "Checksum mismatch — the downloaded list was rejected and the previous one kept."
msgstr "驗證值不匹配 — 下載的列表已被拒絕，繼續使用原列表。"

msgid "The downloaded list contains no category groups — it was rejected."
msgstr "下載的列表不含任何分組 — 已拒絕使用。"

msgid "The downloaded list could not be parsed — the previous one was kept."
msgstr "下載的列表無法解析 — 繼續使用原列表。"
