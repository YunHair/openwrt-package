
config wechatpush "config"
	option enable '0'
	option sleeptime '60'
	option debuglevel '1'
	option up_timeout '2'
	option down_timeout '10'
	option timeout_retry_count '2'
    option thread_num '3'
	option tg_api_server 'https://api.telegram.org'
	option tg_chat_id ''
	# 流量数据源：auto（默认：有 wrtbwmon 用它，否则用 OAF）/ wrtbwmon（原版行为）/ oaf（OpenAppFilter via ubus）
	option traffic_source 'auto'
	# 跨天累计总流量（仅 OAF 模式有效）：开启后 wechatpush 自行维护累计基线，抵消 OAF 每日零点归零；wrtbwmon 自身已累计，无需开启
	option traffic_accumulate '0'
