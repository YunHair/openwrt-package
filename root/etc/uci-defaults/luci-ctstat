#!/bin/sh
# 首次安装初始化
[ -f /etc/config/ctstat ] || touch /etc/config/ctstat

uci -q get ctstat.config.enabled >/dev/null 2>&1 || {
	uci -q batch <<-EOT
		set ctstat.config=config
		set ctstat.config.enabled='1'
		set ctstat.config.interval='3'
		set ctstat.config.lan_prefix=''
		set ctstat.config.refresh='5'
		commit ctstat
	EOT
}

chmod +x /usr/share/ctstat/collector.sh 2>/dev/null
chmod +x /usr/libexec/ctstat-call 2>/dev/null

/etc/init.d/ctstat enable 2>/dev/null
/etc/init.d/ctstat restart 2>/dev/null

exit 0
