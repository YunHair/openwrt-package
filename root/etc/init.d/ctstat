#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

PROG=/usr/share/ctstat/collector.sh

start_service() {
	[ -x "$PROG" ] || chmod +x "$PROG"

	# 清理上次异常退出残留
	rm -f /tmp/ctstat/lock /tmp/ctstat/*.new

	procd_open_instance
	procd_set_param command /bin/sh "$PROG"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	rm -f /tmp/ctstat/lock
	# 退出时保存累计表
	[ -f /tmp/ctstat/clients.db ] && {
		mkdir -p /etc/ctstat
		cp -f /tmp/ctstat/clients.db /etc/ctstat/clients.db
	}
}

service_triggers() {
	procd_add_reload_trigger ctstat
}
