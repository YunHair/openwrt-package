{
	"luci-app-ctstat": {
		"description": "Grant access to ctstat client traffic statistics",
		"read": {
			"ubus": {
				"uci": [ "get", "show" ]
			},
			"file": {
				"/usr/libexec/ctstat-call": [ "exec" ]
			}
		},
		"write": {
			"ubus": {
				"uci": [ "set", "delete", "commit", "apply" ]
			},
			"file": {
				"/usr/libexec/ctstat-call": [ "exec" ]
			}
		}
	}
}
